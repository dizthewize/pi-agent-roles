{
  "name": "pi-agent-roles",
  "version": "0.1.0",
  "description": "Lightweight role-based delegation for Pi — define roles, dispatch tasks, get results",
  "type": "module",
  "scripts": {
    "test": "node --test --import jiti/register 'src/**/*.test.ts'",
    "test:all": "node --test --import jiti/register 'src/**/*.test.ts' 'test/**/*.test.ts'",
    "test:ci": "CI=true node --test --import jiti/register 'src/**/*.test.ts' 'test/**/*.test.ts'"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "roles",
    "delegation",
    "subagent"
  ],
  "files": [
    "src/**/*.ts",
    "*.json",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.74.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "jiti": "^2.7.0"
  },
  "license": "MIT"
}
