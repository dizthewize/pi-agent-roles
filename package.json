{
  "name": "pi-agent-roles",
  "version": "0.1.0",
  "description": "Lightweight role-based delegation for Pi \u2014 define roles, dispatch tasks, get results",
  "type": "module",
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },

  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:all": "vitest run",
    "test:ci": "vitest run"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "roles",
    "delegation",
    "subagent"
  ],
  "files": [
    "src/",
    "default-roles.json",
    "*.json",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.74.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typebox": "^1.1.38",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  },
  "license": "MIT"
}